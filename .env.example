# Chave opcional da API SubQ. Ela fica só no servidor (/api/decide).
# Nunca exponha esta chave com prefixo VITE_.
# Na Vercel, a chave só é usada se houver um armazenamento para o limite de gastos (abaixo).
SUBQ_API_KEY=

# Só na Vercel: armazenamento compartilhado do limite de gastos (Upstash for Redis).
# A integração do Vercel Marketplace cria estas variáveis.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Limite total de gastos da chave do dono, em dólares (padrão: 3).
# SUBQ_DEMO_BUDGET_USD=3
# Preço por 1 milhão de tokens de entrada (padrão: 0.04, subq-snap-1.2).
# SUBQ_PRICE_USD_PER_MILLION_TOKENS=0.04

# URL opcional do endpoint upstream da SubQ (padrao: https://api.subq.ai/v1/systemone).
# Deve usar HTTPS e host *.subq.ai.
# SUBQ_API_URL=https://api.subq.ai/v1/systemone
